              "left": {"kind": "col", "name": "amount"},
              "right": {"kind": "lit", "value": 4}}},

    {"id": "j_nullkey", "op": "join", "kind": "inner",
     "left": "s_src", "right": "s_right",
     "on": [{"left": "grp", "right": "grp"},
            {"left": "name", "right": "code"}],
     "right_prefix": "r_"},

    {"id": "anti_j", "op": "join", "kind": "anti",
     "left": "s_src", "right": "s_anti_r",
     "on": [{"left": "grp", "right": "grp"}],
     "right_prefix": "r_"},

    {"id": "empty_grp", "op": "group", "input": "s_empty",
     "keys": ["grp"],
     "aggs": [
       {"name": "cnt", "func": "count", "arg": null},
       {"name": "amt", "func": "sum", "arg": "amount"}
     ]},

    {"id": "dup_a", "op": "project", "input": "s_dup",
     "columns": [{"name": "v", "keep": "v"}]},
    {"id": "dup_b", "op": "project", "input": "s_dup",
     "columns": [{"name": "v", "keep": "v"}]},
    {"id": "dup_union", "op": "union_all", "inputs": ["dup_a", "dup_b"]},
    {"id": "dup_distinct", "op": "distinct", "input": "dup_union", "keys": ["v"]},

    {"id": "top1", "op": "top_k", "input": "s_top", "k": 1,
     "partition_by": ["p"],
     "order_by": [
       {"expr": {"kind": "col", "name": "score"}, "dir": "desc", "decisive": false},
       {"expr": {"kind": "col", "name": "tie"}, "dir": "asc", "decisive": true}
     ]},

    {"id": "pad_join", "op": "join", "kind": "left",
     "left": "s_pad", "right": "s_pad_r",
     "on": [{"left": "k", "right": "k"}],
